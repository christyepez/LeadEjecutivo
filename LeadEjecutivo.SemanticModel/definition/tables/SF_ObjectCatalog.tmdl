table SF_ObjectCatalog
	column Name
		dataType: string
		sourceColumn: Name
	column Kind
		dataType: string
		sourceColumn: Kind
	partition SF_ObjectCatalog = m
		mode: import
		source = ```
let
    Source = SalesforceSource,
    Keep = Table.SelectColumns(Source,{"Name","Kind"}, MissingField.UseNull),
    Sort = Table.Sort(Keep,{{"Name", Order.Ascending}})
in
    Sort
```
