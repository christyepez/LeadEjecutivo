table DimCarrera
	column Carrera
		dataType: string
		sourceColumn: Carrera

	partition DimCarrera = m
		mode: import
		source = ```
let
    Source = SalesforceSource,
    Lead = Source{[Name="Lead"]}[Data],
    Keep = Table.SelectColumns(Lead,{"UI_CarreraPrimeraOpcionWeb__c"}, MissingField.UseNull),
    Rename = Table.RenameColumns(Keep,{{"UI_CarreraPrimeraOpcionWeb__c","Carrera"}}),
    Clean = Table.SelectRows(Rename, each [Carrera] <> null and Text.Trim(Text.From([Carrera])) <> ""),
    DistinctRows = Table.Distinct(Clean)
in
    DistinctRows
```
