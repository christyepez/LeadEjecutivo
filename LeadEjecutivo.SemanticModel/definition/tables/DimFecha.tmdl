table DimFecha
	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		sourceColumn: Date

	partition DimFecha = m
		mode: import
		source = ```
let
    Today = Date.From(DateTime.LocalNow()),
    StartDate = #date(2026, 5, 1),
    EndDate = Today,
    DayCount = Duration.Days(EndDate - StartDate) + 1,
    Dates = if DayCount > 0 then List.Dates(StartDate, DayCount, #duration(1,0,0,0)) else {},
    T = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
    Typed = Table.TransformColumns(T, {{"Date", each DateTime.From(_), type datetime}})
in
    Typed
```
