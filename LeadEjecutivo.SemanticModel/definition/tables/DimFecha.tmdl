table DimFecha
	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		sourceColumn: Date

	partition DimFecha = m
		mode: import
		source = ```
let
    Today = Date.From(DateTime.LocalNow()),
    StartDate = #date(Date.Year(Today)-5, 1, 1),
    EndDate = #date(Date.Year(Today)+1, 12, 31),
    DayCount = Duration.Days(EndDate - StartDate) + 1,
    Dates = List.Dates(StartDate, DayCount, #duration(1,0,0,0)),
    T = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
    Typed = Table.TransformColumns(T, {{"Date", each DateTime.From(_), type datetime}})
in
    Typed
```
