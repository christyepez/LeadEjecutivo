table Candidato
\tlineageTag: 5898f84c-b2e9-42c9-bc67-df303b3d07fe

\tmeasure 'Total Leads' = COUNTROWS(Candidato)
\t\tformatString: #,0

\tmeasure 'Leads Gestionados' = CALCULATE([Total Leads], Candidato[Status] <> "Perdido")
\t\tformatString: #,0

\tmeasure 'Leads Perdidos' = CALCULATE([Total Leads], Candidato[Status] = "Perdido")
\t\tformatString: #,0

\tmeasure 'Citas Efectivas' = CALCULATE([Total Leads], Candidato[Status] = "Cita efectiva")
\t\tformatString: #,0

\tmeasure 'Total Matriculas' = CALCULATE([Total Leads], Candidato[Status] IN {"Matriculado", "Matrícula", "Matricula"})
\t\tformatString: #,0
\t\tdescription: Mapeo provisional por Status. Validar contra objeto de matrícula en Salesforce.

\tmeasure 'Total Inscritos' = CALCULATE([Total Leads], Candidato[Status] IN {"Inscrito", "Inscripción", "Inscripcion"})
\t\tformatString: #,0
\t\tdescription: Mapeo provisional por Status. Validar contra objeto de inscripción en Salesforce.

\tmeasure 'Total Proyectados' = CALCULATE([Total Leads], Candidato[Status] = "Proyectado")
\t\tformatString: #,0
\t\tdescription: Mapeo provisional por Status. Validar con negocio/Salesforce.

\tmeasure '% Lead a Cita' = DIVIDE([Citas Efectivas], [Total Leads])
\t\tformatString: 0.0%

\tmeasure '% Lead a Matricula' = DIVIDE([Total Matriculas], [Total Leads])
\t\tformatString: 0.0%

\tmeasure '% Gestionado a Matricula' = DIVIDE([Total Matriculas], [Leads Gestionados])
\t\tformatString: 0.0%

\tmeasure 'Matriculas YTD' = TOTALYTD([Total Matriculas], DimFecha[Date])
\t\tformatString: #,0

\tmeasure 'Inscritos YTD' = TOTALYTD([Total Inscritos], DimFecha[Date])
\t\tformatString: #,0

\tmeasure 'Proyectados YTD' = TOTALYTD([Total Proyectados], DimFecha[Date])
\t\tformatString: #,0

\tmeasure 'Leads Sin Actividad 7d' = CALCULATE([Leads Gestionados], FILTER(Candidato, ISBLANK(Candidato[LastActivityDate]) || DATEDIFF(Candidato[LastActivityDate], TODAY(), DAY) >= 7))
\t\tformatString: #,0

\tmeasure 'Leads Sin Actividad 30d' = CALCULATE([Leads Gestionados], FILTER(Candidato, ISBLANK(Candidato[LastActivityDate]) || DATEDIFF(Candidato[LastActivityDate], TODAY(), DAY) >= 30))
\t\tformatString: #,0

\tmeasure '% Perdidos' = DIVIDE([Leads Perdidos], [Total Leads])
\t\tformatString: 0.0%

\tcolumn Id
\t\tdataType: string
\t\tsourceColumn: Id

\tcolumn Status
\t\tdataType: string
\t\tsourceColumn: Status

\tcolumn CreatedDate
\t\tdataType: dateTime
\t\tformatString: General Date
\t\tsourceColumn: CreatedDate

\tcolumn LastActivityDate
\t\tdataType: dateTime
\t\tformatString: General Date
\t\tsourceColumn: LastActivityDate

\tcolumn OwnerId
\t\tdataType: string
\t\tsourceColumn: OwnerId

\tcolumn OwnerName
\t\tdataType: string
\t\tsourceColumn: Owner.Name

\tcolumn UI_Periodo__c
\t\tdataType: string
\t\tsourceColumn: UI_Periodo__c

\tcolumn UI_Sede__c
\t\tdataType: string
\t\tsourceColumn: UI_Sede__c

\tcolumn UI_UnidadNegocio__c
\t\tdataType: string
\t\tsourceColumn: UI_UnidadNegocio__c

\tcolumn UI_CarreraPrimeraOpcionWeb__c
\t\tdataType: string
\t\tsourceColumn: UI_CarreraPrimeraOpcionWeb__c

\tcolumn UI_Modalidad__c
\t\tdataType: string
\t\tsourceColumn: UI_Modalidad__c

\tcolumn UI_Origen__c
\t\tdataType: string
\t\tsourceColumn: UI_Origen__c

\tcolumn UI_Campana__c
\t\tdataType: string
\t\tsourceColumn: UI_Campana__c

\tcolumn UI_RazonPerdido__c
\t\tdataType: string
\t\tsourceColumn: UI_RazonPerdido__c

\tcolumn UI_SubrazonPerdido__c
\t\tdataType: string
\t\tsourceColumn: UI_SubrazonPerdido__c

\tpartition Candidato = m
\t\tmode: import
\t\tsource = ```
let
    Source = SalesforceSource,
    Lead = Source{[Name="Lead"]}[Data],
    Keep = Table.SelectColumns(Lead,{"Id","Status","CreatedDate","LastActivityDate","OwnerId","Owner.Name","UI_Periodo__c","UI_Sede__c","UI_UnidadNegocio__c","UI_CarreraPrimeraOpcionWeb__c","UI_Modalidad__c","UI_Origen__c","UI_Campana__c","UI_RazonPerdido__c","UI_SubrazonPerdido__c"}, MissingField.UseNull)
in
    Keep
```
